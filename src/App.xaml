<Application
    x:Class="AITranslator.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#FF26636E</Color>
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFF4FAFB" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AppSubtleBrush" Color="#FFE8F4F5" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#FFC4D9DC" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#FF07171C" />
                    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#FF46666D" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#FF26636E" />
                    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#FF1E515B" />
                    <SolidColorBrush x:Key="AppAccentTextBrush" Color="#FF087D91" />
                    <SolidColorBrush x:Key="AppDangerBrush" Color="#FFB5473B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#FF26636E</Color>
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF020A12" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FF061722" />
                    <SolidColorBrush x:Key="AppSubtleBrush" Color="#FF0A202C" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#FF164554" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#FFE6F5F6" />
                    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#FF8FB3B8" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#FF26636E" />
                    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#FF317985" />
                    <SolidColorBrush x:Key="AppAccentTextBrush" Color="#FF39C3D0" />
                    <SolidColorBrush x:Key="AppDangerBrush" Color="#FFFF8A80" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AppSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AppMutedTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AppAccentTextBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AppDangerBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
            </Style>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AppAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16,9" />
            </Style>
            <Style x:Key="ToolPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
