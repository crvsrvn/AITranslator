<Window
    x:Class="AITranslator.Windows.CaptureOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="Root"
        Background="Black"
        IsTabStop="True"
        PointerMoved="Root_PointerMoved"
        PointerReleased="Root_PointerReleased">
        <Image x:Name="DesktopImage" Stretch="Fill" />
        <Rectangle
            x:Name="ResultDimmer"
            Fill="#99000000"
            Visibility="Collapsed" />

        <Canvas x:Name="OverlayCanvas">
            <Rectangle
                x:Name="SelectionRectangle"
                Fill="#22FFFFFF"
                Stroke="{ThemeResource AppAccentTextBrush}"
                StrokeThickness="2"
                Visibility="Collapsed" />

            <Grid
                x:Name="CaptureSurface"
                Background="Black"
                Visibility="Collapsed">
                <Image x:Name="CaptureImage" Stretch="Fill" />
                <Canvas x:Name="TextLayer" Background="Transparent" />
                <Border
                    x:Name="StatusPanel"
                    MaxWidth="420"
                    Padding="14,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AppSurfaceBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressRing
                            x:Name="StatusProgress"
                            Width="20"
                            Height="20"
                            IsActive="True" />
                        <TextBlock
                            x:Name="StatusText"
                            VerticalAlignment="Center"
                            Text="{Binding RecognizingText}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                x:Name="Toolbar"
                Padding="6"
                Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed">
                <StackPanel x:Name="ToolbarPanel" Orientation="Horizontal" Spacing="6">
                    <Button
                        x:Name="ShowOriginalButton"
                        Click="ShowOriginalButton_Click"
                        IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="View" />
                            <TextBlock Text="{Binding Original}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ShowTranslationButton"
                        Click="ShowTranslationButton_Click"
                        IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Switch" />
                            <TextBlock Text="{Binding Translated}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="CopyOriginalButton"
                        Click="CopyOriginalButton_Click"
                        IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Copy" />
                            <TextBlock Text="{Binding CopyOriginal}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="CopyTranslationButton"
                        Click="CopyTranslationButton_Click"
                        IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Copy" />
                            <TextBlock Text="{Binding CopyTranslation}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="CopyImageButton"
                        Click="CopyImageButton_Click"
                        IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Copy" />
                            <TextBlock Text="{Binding CopyImage}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Canvas>

        <Button
            x:Name="CancelButton"
            Width="40"
            Height="40"
            Margin="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Click="CancelButton_Click"
            CornerRadius="4"
            ToolTipService.ToolTip="{Binding CancelCapture}">
            <SymbolIcon Symbol="Cancel" />
        </Button>
    </Grid>
</Window>
