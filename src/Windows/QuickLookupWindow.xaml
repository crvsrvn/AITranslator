<Window
    x:Class="AITranslator.Windows.QuickLookupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ContentControl
        x:Name="Root"
        Background="{ThemeResource AppSurfaceBrush}"
        BorderBrush="{ThemeResource AppBorderBrush}"
        BorderThickness="1"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch">
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="TitleBar"
                Padding="16,0,8,0"
                Background="{ThemeResource AppSurfaceBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    Source="Assets/AITranslator.png"
                    Stretch="Uniform" />
                <StackPanel
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Name="QueryText"
                        FontSize="17"
                        FontWeight="SemiBold"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Width="36"
                    Height="36"
                    Click="CloseButton_Click"
                    ToolTipService.ToolTip="关闭">
                    <SymbolIcon Symbol="Cancel" />
                </Button>
            </Grid>

            <Grid x:Name="ResultGrid" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DictionaryColumn" Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ScrollViewer
                    x:Name="DictionaryPanel"
                    AutomationProperties.AutomationId="DictionaryPanel"
                    AutomationProperties.Name="离线词典"
                    Padding="18,16">
                    <StackPanel Spacing="10">
                        <TextBlock
                            x:Name="DictionaryHeading"
                            AutomationProperties.AutomationId="DictionaryHeading"
                            AutomationProperties.Name="离线词典"
                            Style="{StaticResource SectionTitleStyle}"
                            Text="离线词典" />
                        <ItemsControl x:Name="DictionaryPronunciationItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,4" Orientation="Horizontal" Spacing="8">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource AppMutedTextBrush}"
                                            Text="{Binding Ipa}" />
                                        <Button
                                            Padding="6"
                                            Click="PronunciationButton_Click"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="按 IPA 发音">
                                            <SymbolIcon Symbol="Volume" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            x:Name="DictionaryResultText"
                            AutomationProperties.AutomationId="DictionaryResultText"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <Rectangle
                    x:Name="DictionaryDivider"
                    Grid.Column="1"
                    Fill="{ThemeResource AppBorderBrush}" />

                <ScrollViewer
                    x:Name="AiPanel"
                    Grid.Column="2"
                    AutomationProperties.AutomationId="AiPanel"
                    AutomationProperties.Name="AI 结果"
                    Padding="18,16">
                    <StackPanel Spacing="10">
                        <TextBlock
                            x:Name="AiHeading"
                            AutomationProperties.AutomationId="AiHeading"
                            AutomationProperties.Name="AI 结果"
                            Style="{StaticResource SectionTitleStyle}"
                            Text="AI 结果" />
                        <ItemsControl x:Name="AiPronunciationItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,4" Orientation="Horizontal" Spacing="8">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource AppMutedTextBrush}"
                                            Text="{Binding Ipa}" />
                                        <Button
                                            Padding="6"
                                            Click="PronunciationButton_Click"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="发音">
                                            <SymbolIcon Symbol="Volume" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            x:Name="AiResultText"
                            AutomationProperties.AutomationId="AiResultText"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid
                Grid.Row="2"
                Padding="8,4"
                Background="{ThemeResource AppSurfaceBrush}">
                <ProgressRing
                    x:Name="BusyRing"
                    Width="22"
                    Height="22"
                    HorizontalAlignment="Right"
                    IsActive="True" />
            </Grid>
        </Grid>
    </ContentControl>
</Window>
